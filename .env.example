TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL connection string. Leave unset locally if you don't need the
# database — the site and /api/products both degrade gracefully without it
# (see db/client.js).
DATABASE_URL=

# Admin panel (Stage 3). Single admin identity, no admin_users table.
# Generate ADMIN_PASSWORD_HASH with: npm run admin:hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Long random string used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cloudflare R2 (Stage 5). Optional locally — new-image upload in the admin
# panel responds 503 when unset, but the site and existing admin product
# CRUD still work (see storage/r2-client.js).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL used to serve uploaded images (a connected custom domain
# is preferred). Must NOT be the R2 S3 API endpoint.
R2_PUBLIC_BASE_URL=
