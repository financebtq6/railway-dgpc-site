TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL connection string. Leave unset locally if you don't need the
# database — the site and /api/products both degrade gracefully without it
# (see db/client.js).
DATABASE_URL=

# Admin panel (Stage 3). Single admin identity, no admin_users table.
# Generate ADMIN_PASSWORD_HASH with: npm run admin:hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Long random string used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
